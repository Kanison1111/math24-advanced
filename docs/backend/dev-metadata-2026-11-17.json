  "constraints": [
    {
      "name": "math24_join_limits_attempts_check",
      "table": "math24_join_limits",
      "definition": "CHECK (attempts >= 0)"
    },
    {
      "name": "math24_join_limits_pkey",
      "table": "math24_join_limits",
      "definition": "PRIMARY KEY (user_id)"
    },
    {
      "name": "math24_join_limits_user_id_fkey",
      "table": "math24_join_limits",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "name": "math24_room_members_nickname_check",
      "table": "math24_room_members",
      "definition": "CHECK (char_length(btrim(nickname)) >= 1 AND char_length(btrim(nickname)) <= 24)"
    },
    {
      "name": "math24_room_members_pkey",
      "table": "math24_room_members",
      "definition": "PRIMARY KEY (room_id, user_id)"
    },
    {
      "name": "math24_room_members_role_check",
      "table": "math24_room_members",
      "definition": "CHECK (role = ANY (ARRAY['host'::text, 'player'::text]))"
    },
    {
      "name": "math24_room_members_room_id_fkey",
      "table": "math24_room_members",
      "definition": "FOREIGN KEY (room_id) REFERENCES math24_rooms(id) ON DELETE CASCADE"
    },
    {
      "name": "math24_room_members_user_id_fkey",
      "table": "math24_room_members",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "name": "math24_mix_valid",
      "table": "math24_rooms",
      "definition": "CHECK (difficulty = 'mixed'::text AND (mix_easy + mix_medium + mix_hard) = question_count OR difficulty <> 'mixed'::text AND mix_easy = 0 AND mix_medium = 0 AND mix_hard = 0)"
    },
    {
      "name": "math24_rooms_code_check",
      "table": "math24_rooms",
      "definition": "CHECK (code ~ '^[0-9]{6}$'::text)"
    },
    {
      "name": "math24_rooms_code_key",
      "table": "math24_rooms",
      "definition": "UNIQUE (code)"
    },
    {
      "name": "math24_rooms_difficulty_check",
      "table": "math24_rooms",
      "definition": "CHECK (difficulty = ANY (ARRAY['easy'::text, 'medium'::text, 'hard'::text, 'mixed'::text]))"
    },
    {
      "name": "math24_rooms_duration_minutes_check",
      "table": "math24_rooms",
      "definition": "CHECK (duration_minutes >= 1 AND duration_minutes <= 120)"
    },
    {
      "name": "math24_rooms_mix_easy_check",
      "table": "math24_rooms",
      "definition": "CHECK (mix_easy >= 0 AND mix_easy <= 20)"
    },
    {
      "name": "math24_rooms_mix_hard_check",
      "table": "math24_rooms",
      "definition": "CHECK (mix_hard >= 0 AND mix_hard <= 20)"
    },
    {
      "name": "math24_rooms_mix_medium_check",
      "table": "math24_rooms",
      "definition": "CHECK (mix_medium >= 0 AND mix_medium <= 20)"
    },
    {
      "name": "math24_rooms_mode_check",
      "table": "math24_rooms",
      "definition": "CHECK (mode = ANY (ARRAY['basic'::text, 'advanced'::text]))"
    },
    {
      "name": "math24_rooms_name_check",
      "table": "math24_rooms",
      "definition": "CHECK (char_length(btrim(name)) >= 1 AND char_length(btrim(name)) <= 60)"
    },
    {
      "name": "math24_rooms_owner_id_fkey",
      "table": "math24_rooms",
      "definition": "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "name": "math24_rooms_pkey",
      "table": "math24_rooms",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "math24_rooms_question_count_check",
      "table": "math24_rooms",
      "definition": "CHECK (question_count = ANY (ARRAY[5, 10, 15, 20]))"
    },
    {
      "name": "math24_rooms_ranking_mode_check",
      "table": "math24_rooms",
      "definition": "CHECK (ranking_mode = ANY (ARRAY['live'::text, 'final'::text]))"
    },
    {
      "name": "math24_rooms_status_check",
      "table": "math24_rooms",
      "definition": "CHECK (status = ANY (ARRAY['waiting'::text, 'started'::text, 'finished'::text]))"
    }
  ],
